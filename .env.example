# Copy to .env and fill in. Never commit .env. Never put real PHI in this prototype.

# --- Tenant ---
PAYER_ORG_ID=acme-health
PAYER_DISPLAY_NAME=Acme Health Plan

# --- Database (docker compose creates both roles) ---
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
APP_DB_PASSWORD=change-me-app-db
# Used only when running the middleware outside docker:
DATABASE_URL=postgresql+asyncpg://payer_app:change-me-app-db@localhost:5432/payer_ai

# --- Retell (https://dashboard.retellai.com > API Keys) ---
# The API key also verifies X-Retell-Signature on every webhook and tool call.
RETELL_API_KEY=
# Replace with the IDs printed by: python scripts/provision_retell.py --base-url https://<tunnel>
# The *_local placeholders match scripts/simulate_call.py so local replays route
# to the right line before you have Retell agents.
RETELL_MEMBER_AGENT_ID=agent_member_local
RETELL_PROVIDER_AGENT_ID=agent_provider_local
RETELL_MEMBER_CHAT_AGENT_ID=
RETELL_PROVIDER_CHAT_AGENT_ID=
# Local only, with no Retell key: accept unsigned requests from scripts/simulate_call.py.
# Must be false anywhere real data flows.
ALLOW_UNSIGNED_RETELL=true

# --- Payer core (FACETS gateway; the mock in docker compose by default) ---
FACETS_BASE_URL=http://localhost:8001
FACETS_GATEWAY_KEY=dev-facets-gateway-key
FACETS_TIMEOUT_SECONDS=3
# Production mTLS to the payer's API gateway:
FACETS_CLIENT_CERT=
FACETS_CLIENT_KEY=
FACETS_CA_BUNDLE=

# --- Auth ---
# Admin console bearer token (prototype). Use a long random value.
ADMIN_API_TOKEN=change-me-admin-token
# Shared secret the payer portal uses to sign widget identity tokens (HS256, 32+ chars).
PORTAL_JWT_SECRET=change-me-portal-secret-at-least-32-characters
PORTAL_JWT_AUDIENCE=payer-ai-widget

# Demo portal personas + simulated chat when no Retell chat agent is set.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
